# ── Python ────────────────────────────────────────────────────────────────────
__pycache__/
*.pyc
*.pyo
*.so
*.egg
*.egg-info/
dist/
build/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ── Secrets / config ──────────────────────────────────────────────────────────
# Keep the template, never the real keys.
.env
.env.*
!.env_sample

# ── Model weights & caches (downloaded on first run) ──────────────────────────
/models/
/.cache*
/download
/local/

# ── Runtime data & user content ───────────────────────────────────────────────
/output/
/data/
/custom_voices/
/custom_sounds/
# External plug-ins are DROP-IN: installed into plugins/ via `omnivoice-plugin
# install <git-url>`, a plain git clone, a copy, or a platform installer. Only the
# host-provided SDK and this directory's README are tracked here — every installed
# plug-in lives in its own repo (with its own license) and stays untracked, as
# does the isolated venv each one builds via its bootstrap.
plugins/*
!plugins/_sdk/
!plugins/README.md
*.wav
*.mp3
*.flac
*.ogg
*.mp4
*.mov
*.jsonl

# ── Node / web build ──────────────────────────────────────────────────────────
node_modules/
web/dist/
*.log

# ── Local-only planning notes (keep private) ──────────────────────────────────
ROADMAP.md
agent.md
AGENTS.md

# ── Research: local test media + experiment outputs (never commit) ────────────
examples/box-of-chocolates.wav
# Entire research working area stays out of the repo until the paper is published
research/

# ── Editor / OS ───────────────────────────────────────────────────────────────
.DS_Store
.vscode/
.idea/
.claude/

# ── Upstream OmniVoice scratch dirs ───────────────────────────────────────────
/exp*/
/.tmp/
/results/
results/
example.py
examples/data*
examples/download*
examples/exp*
