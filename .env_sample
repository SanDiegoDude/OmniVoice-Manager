# ── OmniVoice Manager · AI Script providers ───────────────────────────────────
# The Smart Script writer talks to any OpenAI-compatible chat endpoint. Declare
# one provider per line and switch between them live in the UI.
#
#   AI_PROVIDER_<ID> = Label | model | base_url (blank = official OpenAI) | api_key
#
# • <ID> can be anything unique (OPENAI, GEMINI, LOCAL, GROQ, ...).
# • Leave base_url blank to use the official OpenAI API.
# • Comment a line out to hide that provider from the UI.
# • After editing this file, click "Refresh" next to the provider picker in the
#   UI to reload it live — no server restart needed.

# Official OpenAI
AI_PROVIDER_OPENAI = OpenAI (gpt-5.4-mini) | gpt-5.4-mini |  | sk-your-openai-key-here

# Google Gemini via its OpenAI-compatible endpoint
AI_PROVIDER_GEMINI = Gemini 2.5 Flash | gemini-2.5-flash | https://generativelanguage.googleapis.com/v1beta/openai | your-gemini-key-here

# Google Gemini via VERTEX AI (for keys/projects that are Vertex-only and can't
# use the OpenAI-compatible shim above). The base_url is a special vertex:// URL
# carrying PROJECT and LOCATION; the 4th field is OPTIONAL — leave it blank to use
# Application Default Credentials (run `gcloud auth application-default login`),
# or point it at a service-account JSON file.
#   AI_PROVIDER_<ID> = Label | model | vertex://PROJECT/LOCATION | [service-account.json]
# AI_PROVIDER_VERTEX = Gemini · Vertex | gemini-2.5-flash | vertex://my-gcp-project-id/global |
# AI_PROVIDER_VERTEX = Gemini · Vertex | gemini-2.5-flash | vertex://my-gcp-project-id/global | /abs/path/to/service-account.json

# A local OpenAI-compatible server (LM Studio, Ollama, vLLM, llama.cpp, ...)
# AI_PROVIDER_LOCAL = Local model | your-local-model-name | http://localhost:1234/v1 | not-needed

# ── Legacy single-provider variables (still supported as a fallback) ──────────
# Used only when no AI_PROVIDER_* lines are present.
# OPENAI_API_KEY=
# OPENAI_MODEL=gpt-4.1-mini
# SCRIPT_AI_URL=https://generativelanguage.googleapis.com/v1beta/openai
# SCRIPT_AI_MODEL=gemini-2.5-flash
# SCRIPT_AI_API_KEY=

# ── Vertex AI via the standard google-genai env vars ──────────────────────────
# Alternative to an AI_PROVIDER_VERTEX line above — auto-registers a "vertex"
# provider when GENAI_BACKEND=vertex (or GOOGLE_GENAI_USE_VERTEXAI=true) and a
# project is set. Credentials come from ADC / GOOGLE_APPLICATION_CREDENTIALS.
# GENAI_BACKEND=vertex
# GOOGLE_CLOUD_PROJECT=my-gcp-project-id
# GOOGLE_CLOUD_LOCATION=global
# VERTEXAI_LOCATION=global
# VERTEX_MODEL=gemini-2.5-flash
# GOOGLE_APPLICATION_CREDENTIALS=/abs/path/to/service-account.json

# ── Optional overrides ────────────────────────────────────────────────────────
# OMNIVOICE_MODEL=k2-fsa/OmniVoice
# OMNIVOICE_DEVICE=auto   # auto = CUDA > MPS (Apple Silicon) > CPU; or pin cuda:0 / mps / cpu
# OMNIVOICE_ASR_MODEL=openai/whisper-large-v3-turbo
# OMNIVOICE_MELBAND_CKPT=/abs/path/to/vocal_isolation_checkpoint
